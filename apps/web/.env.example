# Salin ke .env.local, isi dari Supabase Dashboard > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# JANGAN pernah expose ke client (tanpa prefix NEXT_PUBLIC_). Hanya dipakai
# server-side di lib/supabase/admin.ts untuk operasi yang butuh bypass RLS
# (mis. FORCE_REVOKE M13, lihat komentar di admin.ts).
SUPABASE_SERVICE_ROLE_KEY=

# Enkripsi agent_ai_connections.encrypted_api_key (M13 BYOK, lib/crypto/byok.ts).
# 32 byte, base64. Generate dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# JANGAN dipakai ulang antar environment (dev/staging/prod beda key) — kalau
# key hilang/berubah, semua encrypted_api_key yang tersimpan tidak bisa
# didekripsi lagi (Agent harus rotate/re-create koneksinya).
BYOK_ENCRYPTION_KEY=

# Shared secret minimal untuk endpoint webhook provider learning session
# (POST /integrations/learning-session/providers/{provider}/events, M04).
# BUKAN pengganti signature verification per-provider sungguhan (di luar
# scope, tidak evidenced) — hanya baseline supaya endpoint admin-bypass-RLS
# ini tidak terbuka bebas tanpa pengecekan apa pun. Generate bebas (string
# acak panjang), beri tahu provider/integrator lewat header X-Webhook-Secret.
LEARNING_SESSION_WEBHOOK_SECRET=

# Midtrans (M14 Commercial, payment gateway MVP). Dari dashboard.sandbox.midtrans.com
# (atau dashboard.midtrans.com untuk Production — TIDAK dipakai di kode ini,
# lib/payments/midtrans.ts SELALU memanggil base URL *.sandbox.midtrans.com,
# lihat catatan keamanan di file itu). Server Key dipakai untuk Basic Auth ke
# Snap API DAN untuk menghitung signature webhook (SHA512(order_id+status_code+
# gross_amount+ServerKey), Midtrans §7/§10) — JANGAN pernah expose ke client.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
